{
  "minSeverity": "warning",
  "maxComplexity": 10,
  "maxFunctionLines": 80,
  "maxFileLines": 500,
  "maxConsoleCalls": 12,
  "contextLines": 2,
  "maxFileBytes": 10485760,
  "ignore": [
    "node_modules",
    ".git",
    ".hg",
    ".svn",
    ".bug-hunter"
  ],
  "disableRules": [],
  "baseline": ".bug-hunter-baseline.json",
  "baselineMode": "ignore",
  "consoleAllowedPaths": [
    "tools",
    "scripts",
    "test",
    "tests",
    "examples"
  ]
}
